          )
          (1): ELU(alpha=1.0)
          (2): Linear(
            (net): Linear(in_features=256, out_features=512, bias=True)
          )
          (3): ELU(alpha=1.0)
          (4): Linear(
            (net): Linear(in_features=512, out_features=1536, bias=True)
          )
          (5): ELU(alpha=1.0)
        )
      )
      (cell): Transformer(
        (pos_embs): PositionalEmbedding()
        (drop): Dropout(p=0.1, inplace=False)
        (layers): ModuleList(
          (0-5): 6 x TransformerEncoderLayer(
            (mah): MultiheadAttention(
              (q_net): Linear(
                (net): Linear(in_features=600, out_features=512, bias=False)
              )
              (k_net): Linear(
                (net): Linear(in_features=600, out_features=512, bias=False)
              )
              (v_net): Linear(
                (net): Linear(in_features=600, out_features=512, bias=False)
              )
              (out_net): Linear(
                (net): Linear(in_features=512, out_features=600, bias=False)
              )
              (drop): Dropout(p=0.1, inplace=False)
              (dropatt): Dropout(p=0.1, inplace=False)
              (layer_norm): LayerNorm((600,), eps=1e-05, elementwise_affine=True)
            )
            (pos_ff): PositionwiseFF(
              (CoreNet): Sequential(
                (0): Linear(
                  (net): Linear(in_features=600, out_features=1024, bias=True)
                )
                (1): ReLU(inplace=True)
